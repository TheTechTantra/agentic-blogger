# === BOOTSTRAP SECRETS (cannot live in TinyDB — required for TinyDB itself) ===
# Generate once, keep in .env, never commit
TINYDB_ENC_KEY=                    # Output of: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SECRET_STORE_TOKEN=                # Output of: openssl rand -hex 24
POSTGRES_PASSWORD=                 # Output of: openssl rand -hex 24

# === OPTIONAL OVERRIDES (most services find these via TinyDB at runtime) ===
# Uncomment only if you need to override the stored value for debugging
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# BLOGGER_CLIENT_ID=
# BLOGGER_CLIENT_SECRET=
# BLOGGER_REFRESH_TOKEN=
# BLOGGER_BLOG_ID=

# === DOCKER NETWORK ===
DOCKER_NETWORK=agentic-blogger-net
DOCKER_NETWORK_EXTERNAL=false

# === DATA VOLUMES ===
VAULT_DIR=./data/vault
POSTGRES_DATA=./data/postgres
MLFLOW_ARTIFACTS=./data/mlartifacts
ASSETS_DIR=./data/assets
